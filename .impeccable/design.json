  "components": [
    {
      "name": "Action Button",
      "kind": "button",
      "refersTo": "button-action",
      "description": "Amber: the one primary action of a region (Cerca, Crea viaggio, Assistente).",
      "html": "<button class=\"ds-btn-action\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z\"/></svg> Cerca</button>",
      "css": ":host{--color-brand-500:#ffb000;--color-brand-300:#ffc840;--color-board:#0e0f11;--color-board-cell:#191b1f;--color-board-frame:#2a2d31;--color-board-text:#f2f2f0;--color-board-dim:#9a9ea5;--color-ink:#0e0f11;--color-danger:#c4161c;--color-surface:#fff;--color-line:#d2d5d8;font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif}.ds-btn-action{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:4px;font-weight:600;font-size:14px;letter-spacing:0.01em;border:none;cursor:pointer;transition:background-color 150ms,border-color 150ms,transform 160ms cubic-bezier(0.23,1,0.32,1);background:var(--color-brand-500);color:var(--color-ink)}.ds-btn-action:hover{background:var(--color-brand-300)}.ds-btn-action:active{transform:scale(0.97)}.ds-btn-action:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px;box-shadow:0 0 0 4px var(--color-brand-500);}"
    },
    {
      "name": "Board Button",
      "kind": "button",
      "refersTo": "button-board",
      "description": "Black board button for strong non-primary actions.",
      "html": "<button class=\"ds-btn-board\">Salva viaggio</button>",
      "css": ":host{--color-brand-500:#ffb000;--color-brand-300:#ffc840;--color-board:#0e0f11;--color-board-cell:#191b1f;--color-board-frame:#2a2d31;--color-board-text:#f2f2f0;--color-board-dim:#9a9ea5;--color-ink:#0e0f11;--color-danger:#c4161c;--color-surface:#fff;--color-line:#d2d5d8;font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif}.ds-btn-board{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:4px;font-weight:600;font-size:14px;letter-spacing:0.01em;border:none;cursor:pointer;transition:background-color 150ms,border-color 150ms,transform 160ms cubic-bezier(0.23,1,0.32,1);background:var(--color-ink);color:var(--color-board-text)}.ds-btn-board:hover{background:var(--color-board-frame)}.ds-btn-board:active{transform:scale(0.97)}.ds-btn-board:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px;box-shadow:0 0 0 4px var(--color-brand-500);}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Quiet secondary action on the concourse.",
      "html": "<button class=\"ds-btn-outline\">Cerca ispirazione</button>",
      "css": ":host{--color-brand-500:#ffb000;--color-brand-300:#ffc840;--color-board:#0e0f11;--color-board-cell:#191b1f;--color-board-frame:#2a2d31;--color-board-text:#f2f2f0;--color-board-dim:#9a9ea5;--color-ink:#0e0f11;--color-danger:#c4161c;--color-surface:#fff;--color-line:#d2d5d8;font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif}.ds-btn-outline{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:4px;font-weight:600;font-size:14px;letter-spacing:0.01em;border:none;cursor:pointer;transition:background-color 150ms,border-color 150ms,transform 160ms cubic-bezier(0.23,1,0.32,1);background:var(--color-surface);color:var(--color-ink);border:1px solid rgb(14 15 17 / 0.25)}.ds-btn-outline:hover{border-color:var(--color-ink)}.ds-btn-outline:active{transform:scale(0.97)}.ds-btn-outline:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px;box-shadow:0 0 0 4px var(--color-brand-500);}"
    },
    {
      "name": "Text Field",
      "kind": "input",

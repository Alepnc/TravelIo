# Copia in .env.local e personalizza. Nessun segreto va mai committato.

# ───────── Database ─────────
# In locale: lascia vuoto, `npm run dev` avvia PGlite (PostgreSQL locale in data/pglite).
# In produzione (Vercel): la stringa di connessione Postgres, es. Neon dal Marketplace di Vercel:
#   DATABASE_URL=postgres://utente:password@host/db?sslmode=require
#   DATABASE_URL_UNPOOLED=...  (facoltativa: connessione diretta usata solo per le migrazioni in build)
DATABASE_URL=

# URL pubblico dell'app (link nelle email, metadata)
APP_URL=http://localhost:3000

# ───────── Dati reali di voli e alloggi: SerpApi (Google Flights e Google Hotels) ─────────
# 1. Crea un account su https://serpapi.com (il piano gratuito include 250 ricerche al mese)
# 2. Copia la chiave API qui sotto
# 3. Verifica l'integrazione (usa 4 ricerche):  npm run check:providers -- --yes
SERPAPI_API_KEY=

# Tetto mensile di ricerche che l'app si concede (allinealo al tuo piano).
# Il 70% è usabile per i prezzi indicativi delle pagine di scoperta, il resto è riservato alle ricerche dirette.
SERPAPI_MONTHLY_LIMIT=250

# Durata della cache dei risultati, in minuti (ogni ricerca risparmiata è quota risparmiata)
# SERPAPI_CACHE_FLIGHTS_MINUTES=180
# SERPAPI_CACHE_HOTELS_MINUTES=360
# SERPAPI_CACHE_BOOKING_MINUTES=60
# SERPAPI_CACHE_INDICATIVE_MINUTES=1440

# Cerca anche appartamenti/affitti brevi oltre agli hotel (raddoppia le ricerche alloggi)
# SERPAPI_INCLUDE_RENTALS=true

# Solo per provare l'integrazione senza chiave né quota: server finto locale (npm run fake:serpapi)
# SERPAPI_BASE_URL=http://localhost:4010

# ───────── Provider ─────────
# "serpapi" (default, dati reali) oppure "mock" (dati dimostrativi, solo se lo chiedi esplicitamente)
# FLIGHT_PROVIDER=serpapi
# ACCOMMODATION_PROVIDER=serpapi
# Destinazioni e attività: catalogo curato incluso nel progetto
# DESTINATION_PROVIDER=mock
# ACTIVITY_PROVIDER=mock
# MAPS_PROVIDER=mock

# Solo con provider "mock": latenza (ms) e probabilità di errore (0-1) simulate
# MOCK_LATENCY_MS=250
# MOCK_FAILURE_RATE=0

# ───────── Mappa ─────────
# Di default lo sfondo è OpenStreetMap (nessuna chiave, uso leggero). Per più traffico usa un fornitore di tile:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=LA_TUA_CHIAVE
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# ───────── Assistente AI ─────────
# Senza chiave funziona in modalità "regole" (demo)
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
